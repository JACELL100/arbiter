# Postgres connection string (Supabase -> Project settings -> Database -> Connection string).
# Session pooler (port 5432) or transaction pooler (port 6543) both work.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
# Optional: legacy HS256 JWT secret. If empty, tokens are verified via JWKS or the Supabase auth endpoint.
SUPABASE_JWT_SECRET=
GROQ_API_KEY=
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Optional: OpenRouter key; enables free OpenRouter models (ids prefixed "openrouter/")
OPENROUTER_API_KEY=
